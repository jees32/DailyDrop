# Option A: split vars (recommended — password can contain @ without URL encoding)
user=postgres
password=your_database_password
host=db.your-project-ref.supabase.co
port=5432
dbname=postgres

# If Direct connection DNS fails, use Transaction pooler from Supabase dashboard:
# user=postgres.your-project-ref
# password=your_database_password
# host=aws-0-ap-south-1.pooler.supabase.com
# port=6543
# dbname=postgres

# Option B: single URL (password special chars must be URL-encoded, @ → %40)
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Auth — Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional legacy HS256 secret (Settings → API → JWT Settings).
# Leave empty if your project uses Signing Keys (ECC) — FastAPI verifies via JWKS.
# SUPABASE_JWT_SECRET=your_jwt_secret_here

# Optional — API Keys → Secret key (admin scripts only, NOT for JWT verification)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# Redis catalog cache (docker compose sets this automatically)
# REDIS_URL=redis://localhost:6379/0

# Chatbot v1 — Hugging Face Inference API (cloud, not local transformers)
# Create a token: https://huggingface.co/settings/tokens
# Enable Inference Providers permission on the token.
HF_TOKEN=hf_your_token_here
# Optional override. Must be a model your token can call — list them with:
#   curl -H "Authorization: Bearer $HF_TOKEN" https://router.huggingface.co/v1/models
# Known-good alternatives: google/gemma-3-4b-it, Qwen/Qwen3-8B, openai/gpt-oss-20b
# HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
