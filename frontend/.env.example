NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase — Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase — API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Phone / LAN dev:
# 1. Add allowedDevOrigins in next.config.ts (or set NEXT_PUBLIC_APP_URL below — config reads it)
# 2. Supabase → Auth → Redirect URLs: http://YOUR_LAN_IP:3000/**
# 3. Start frontend: npm run dev -- -H 0.0.0.0 -p 3000
# 4. Start backend: uvicorn main:app --host 0.0.0.0 --port 8000
#
# For `npm run build` + start, use frontend/.env.production.local:
#   NEXT_PUBLIC_APP_URL=http://192.168.1.4:3000
#   NEXT_PUBLIC_API_URL=http://192.168.1.4:8000
